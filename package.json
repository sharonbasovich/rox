{
  "name": "rox-applied-ai-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local prototype of trust & reliability improvements for Rox (evidence ledger, record truth-check, seller context, agent dry-run, eval console).",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "express": "4.21.0",
    "lucide-react": "1.45.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/express": "4.17.21",
    "@types/node": "22.7.4",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "concurrently": "9.0.1",
    "eslint": "9.11.1",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.9.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
